{
  "name": "quartus-assistant",
  "displayName": "VHDL Essentials",
  "description": "VHDL language support, Quartus integration, hover, syntax highlighting and lightweight IntelliSense.",
  "version": "0.10.3",
  "publisher": "Guizzz",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Snippets",
    "Formatters",
    "Education"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "quartus-assistant.build",
        "title": "Quartus: Build"
      },
      {
        "command": "quartus-assistant.flash",
        "title": "Quartus: Flash"
      },
      {
        "command": "quartus-assistant.generateDo",
        "title": "Quartus: Generate QuestaSim DO"
      },
      {
        "command": "quartus-assistant.runDo",
        "title": "Quartus: Run QuestaSim simulation"
      }
    ],
    "languages": [
      {
        "id": "vhdl",
        "aliases": [
          "VHDL",
          "vhdl"
        ],
        "extensions": [
          ".vhd",
          ".vhdl"
        ],
        "configuration": "./syntaxes/language-configuration.json"
      },
      {
        "id": "quartus",
        "extensions": [
          ".qsf",
          ".qpf"
        ],
        "aliases": [
          "Quartus",
          "Quartus Settings File",
          "Quartus Project File"
        ]
      },
      {
        "id": "questasim-do",
        "extensions": [
          ".do"
        ],
        "aliases": [
          "QuestaSim DO"
        ]
      }
    ],
    "configuration": {
      "title": "Quartus",
      "properties": {
        "maxv.quartusPath": {
          "type": "string",
          "default": "C:\\altera_lite\\25.1std",
          "description": "Path to Quartus installation folder (e.g. C:\\intelFPGA\\25.1std)"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "myExtension",
          "title": "Quartus Assistant",
          "icon": "$(chip)"
        }
      ]
    },
    "views": {
      "myExtension": [
        {
          "id": "quartus-assistant-view",
          "name": "Quartus Assistant Panel",
          "icon": "$(chip)"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "view": "quartus-assistant-view",
          "when": "viewItem == testbench",
          "command": "quartus-assistant.generateDo"
        },
        {
          "view": "quartus-assistant-view",
          "when": "viewItem == questascript",
          "command": "quartus-assistant.runDo"
        }
      ]
    },
    "grammars": [
      {
        "language": "vhdl",
        "scopeName": "source.vhdl",
        "path": "./syntaxes/vhdl.tmLanguage.json"
      },
      {
        "language": "questasim-do",
        "scopeName": "source.do",
        "path": "./syntaxes/do.tmLanguage.json"
      },
      {
        "language": "quartus",
        "scopeName": "source.quartus",
        "path": "./syntaxes/quartus.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "npm-run-all": "^4.1.5",
    "serialize-javascript": ">=7.0.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vscode-textmate": "^9.0.0",
    "yaml": "^2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Guizzz/VHDL-Essentials.git"
  },
  "keywords": [
    "quartus",
    "fpga",
    "intel",
    "vhdl",
    "questasim",
    "modelsim",
    "autocompile",
    "simulation",
    "altera",
    "synthesis",
    "intel fpga",
    "vhdl lint",
    "fpga development",
    "testbench",
    "ip core",
    "pin planner"
  ]
}
