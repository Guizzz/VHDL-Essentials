{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": ["./skills"]
  },
  // Plugin disabilitati (chiave V2: "plugins"):
  // - opencode-type-inject / opencode-shell-strategy: non esistono su npm (404)
  // - opencode-conductor: v1.0.6 usa l'API plugin V1, non caricabile in V2
  // Reintrodurli solo quando esiste una versione funzionante.
  "mcp": {
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{file:../secrets/github-token.txt}"
      }
    }
  }
}
